{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"]
  },
  "include": ["src", "shared", "test", "vitest.config.ts"],
  // Tests that import web/src code (render + triage-map mapping tests) are type-checked
  // under tsconfig.web.json (DOM lib) — never with worker fetch types. Vitest still runs
  // them in the pool-workers harness at runtime (file discovery ignores tsconfig).
  "exclude": ["test/mentions.test.ts", "test/render.tickets.test.ts", "test/render.sprints.test.ts", "test/hash.test.ts", "test/render.review.test.ts", "test/render.mywork.test.ts", "test/render.roadmap.test.ts", "test/render.docs.test.ts", "test/triage-map.test.ts", "test/render.notifications.test.ts", "test/render.onboard.test.ts", "test/render.people.test.ts", "test/render.feed.test.ts", "test/render.scroll.test.ts", "test/render.sidebar.test.ts", "test/render.repo.test.ts", "test/issue-ref.test.ts", "test/render.corners.test.ts", "test/render.connect.test.ts"]
}
